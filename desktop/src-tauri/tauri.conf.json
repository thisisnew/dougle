{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Forge",
  "version": "0.1.29",
  "identifier": "dev.knowledgeforge.desktop",
  "build": { "frontendDist": "../host-ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; script-src 'none'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "targets": ["app", "dmg"],
    "resources": ["resources/runtime/**/*", "resources/knowledge-forge.jar", "resources/ai/**/*", "resources/git/**/*", "resources/search-model-e5-v1/**/*"],
    "macOS": { "minimumSystemVersion": "11.3" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRTI2ODA3QTI5QkVCQzMKUldURDY1dWlCMmppWUlsWWlxR1FXR2YzTFIxSmFFMDFwLzUvdFU3eUQ2c1ZDSElNTExORlpKWFkK",
      "endpoints": ["https://raw.githubusercontent.com/thisisnew/dougle/main/updates/preview.json"],
      "requireSignedVersion": true
    }
  }
}
